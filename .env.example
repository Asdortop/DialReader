# Copy this file to .env and paste ONE key (no quotes). .env is git-ignored.
# With both keys empty the GenAI hooks stay off and the classical pipeline runs the same.

# OpenRouter (https://openrouter.ai/keys) - used first if set
OPENROUTER_API_KEY=

# Google AI Studio (https://aistudio.google.com/apikey) - used if OpenRouter is empty
GEMINI_API_KEY=

# Optional. Defaults: anthropic/claude-haiku-5.5 on OpenRouter, low reasoning effort, 2 USD limit.
DIALREADER_VLM_MODEL=
DIALREADER_VLM_REASONING=
DIALREADER_VLM_BUDGET=
